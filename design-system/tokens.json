{
  "$schema": "https://design-tokens.org/schema",
  "name": "Sellisy",
  "version": "1.0.0",
  "color": {
    "background":            { "value": "hsl(0 0% 2%)",     "hex": "#050505" },
    "foreground":            { "value": "hsl(55 56% 97%)",  "hex": "#FAFAF5" },
    "border":                { "value": "hsl(0 0% 12%)" },
    "card":                  { "value": "hsl(0 0% 4%)",     "hex": "#0a0a0a" },
    "cardForeground":        { "value": "hsl(55 20% 90%)" },
    "cardBorder":            { "value": "hsl(0 0% 10%)" },
    "popover":               { "value": "hsl(0 0% 4%)" },
    "popoverForeground":     { "value": "hsl(55 20% 90%)" },
    "popoverBorder":         { "value": "hsl(0 0% 14%)" },
    "primary":               { "value": "hsl(53 91% 61%)",  "hex": "#F5E642" },
    "primaryForeground":     { "value": "hsl(0 0% 2%)",     "hex": "#050505" },
    "secondary":             { "value": "hsl(0 0% 10%)" },
    "secondaryForeground":   { "value": "hsl(55 20% 90%)" },
    "muted":                 { "value": "hsl(0 0% 8%)" },
    "mutedForeground":       { "value": "hsl(0 0% 45%)" },
    "accent":                { "value": "hsl(0 0% 8%)" },
    "accentForeground":      { "value": "hsl(53 91% 61%)",  "hex": "#F5E642" },
    "destructive":           { "value": "hsl(0 72% 51%)" },
    "destructiveForeground": { "value": "hsl(0 0% 100%)",   "hex": "#FFFFFF" },
    "input":                 { "value": "hsl(0 0% 12%)" },
    "ring":                  { "value": "hsl(53 91% 61%)",  "hex": "#F5E642" },
    "sidebar": {
      "bg":                  { "value": "hsl(0 0% 4%)" },
      "fg":                  { "value": "hsl(55 20% 90%)" },
      "border":              { "value": "hsl(0 0% 12%)" },
      "primary":             { "value": "hsl(53 91% 61%)" },
      "primaryFg":           { "value": "hsl(0 0% 2%)" },
      "accent":              { "value": "hsl(0 0% 8%)" },
      "accentFg":            { "value": "hsl(53 91% 61%)" },
      "ring":                { "value": "hsl(53 91% 61%)" }
    },
    "chart": {
      "1": { "value": "hsl(53 91% 61%)",   "label": "yellow (primary)" },
      "2": { "value": "hsl(168 100% 48%)", "label": "teal" },
      "3": { "value": "hsl(18 100% 60%)",  "label": "orange" },
      "4": { "value": "hsl(326 100% 62%)", "label": "pink" },
      "5": { "value": "hsl(160 100% 36%)", "label": "green" }
    },
    "status": {
      "online":  { "value": "rgb(34 197 94)" },
      "away":    { "value": "rgb(245 158 11)" },
      "busy":    { "value": "rgb(239 68 68)" },
      "offline": { "value": "rgb(156 163 175)" }
    },
    "elevate": {
      "1":             { "value": "rgba(255,255,255,0.04)" },
      "2":             { "value": "rgba(255,255,255,0.09)" },
      "buttonOutline": { "value": "rgba(255,255,255,0.10)" },
      "badgeOutline":  { "value": "rgba(255,255,255,0.05)" }
    },
    "landingBrand": {
      "black":  { "value": "#050505" },
      "white":  { "value": "#FAFAF5" },
      "yellow": { "value": "#F5E642" },
      "orange": { "value": "#FF6B35" },
      "pink":   { "value": "#FF3CAC" },
      "teal":   { "value": "#00F5D4" },
      "cream":  { "value": "#F0E6D3" }
    }
  },
  "font": {
    "family": {
      "sans":    { "value": "'DM Sans', sans-serif" },
      "mono":    { "value": "'Space Mono', monospace" },
      "serif":   { "value": "'Source Serif Pro', serif" },
      "display": { "value": "'Bebas Neue', sans-serif" },
      "code":    { "value": "'Fira Code', 'JetBrains Mono', monospace" }
    },
    "tracking": {
      "normal":  { "value": "0em" },
      "label":   { "value": "2px",   "context": ".s-label" },
      "ctaMono": { "value": "0.08em","context": ".cta-mono" },
      "heading": { "value": "-1px",  "context": ".s-heading" }
    }
  },
  "radius": {
    "sm":   { "value": "0.1875rem" },
    "md":   { "value": "0.375rem" },
    "lg":   { "value": "0.5625rem" },
    "default": { "value": "0.75rem", "context": "--radius" },
    "full": { "value": "9999px" }
  },
  "spacing": {
    "base": { "value": "0.25rem", "context": "--spacing, 4px increment" }
  },
  "shadow": {
    "2xs": { "value": "0px 1px 2px 0px rgba(0,0,0,0.3)" },
    "xs":  { "value": "0px 1px 3px 0px rgba(0,0,0,0.3)" },
    "sm":  { "value": "0px 1px 4px 0px rgba(0,0,0,0.25), 0px 1px 2px -1px rgba(0,0,0,0.2)" },
    "base":{ "value": "0px 2px 6px 0px rgba(0,0,0,0.25), 0px 1px 3px -1px rgba(0,0,0,0.2)" },
    "md":  { "value": "0px 4px 8px 0px rgba(0,0,0,0.3), 0px 2px 4px -1px rgba(0,0,0,0.2)" },
    "lg":  { "value": "0px 8px 16px 0px rgba(0,0,0,0.3), 0px 4px 6px -1px rgba(0,0,0,0.2)" },
    "xl":  { "value": "0px 16px 32px 0px rgba(0,0,0,0.3), 0px 8px 12px -1px rgba(0,0,0,0.2)" },
    "2xl": { "value": "0px 24px 48px 0px rgba(0,0,0,0.4)" }
  },
  "breakpoint": {
    "sm":  { "value": "640px" },
    "md":  { "value": "768px" },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" },
    "2xl": { "value": "1536px" }
  },
  "motion": {
    "page": {
      "fadeIn": { "duration": "0.15s", "easing": "ease", "translateY": "4px" },
      "sfPageEnter": { "duration": "0.2s", "easing": "ease-out", "translateY": "8px" }
    },
    "reveal": {
      "sf": { "duration": "0.5s", "easing": "ease-out", "translateY": "24px" },
      "s":  { "duration": "0.7s", "easing": "ease",     "translateY": "32px" }
    },
    "ambientOrbs": {
      "yellow": { "duration": "90s",  "easing": "ease-in-out" },
      "teal":   { "duration": "105s", "easing": "ease-in-out" },
      "pink":   { "duration": "95s",  "easing": "ease-in-out" }
    },
    "ticker":   { "duration": "30s", "easing": "linear" },
    "skeleton": { "duration": "1.6s", "easing": "ease-in-out" },
    "savePulse":{ "duration": "1s", "easing": "ease-in-out" },
    "accordion":{ "duration": "0.2s", "easing": "ease-out" }
  }
}
