# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sellisy

# Session
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://cdn.yourdomain.com

# App
APP_URL=https://yourdomain.com
NODE_ENV=development

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# --- Gumroad Importer (Phase 2+) ---
# Redis for BullMQ job queue. Local dev: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379
# 32-byte hex key for AES-256-GCM token encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUMROAD_TOKEN_ENCRYPTION_KEY=
